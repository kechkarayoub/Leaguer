# Frontend Web Environment Configuration
# Copy this file to .env and update with your values

# App Configuration
REACT_APP_NAME=Leaguer
REACT_APP_VERSION=1.0.0
REACT_APP_BACKEND_ENDPOINT=http://localhost:8080
REACT_APP_FRONTEND_ENDPOINT=http://localhost:3000
REACT_APP_DEFAULT_COUNTRY_CODE="MA"
REACT_APP_DISABLE_LOG_MESSAGE="true"
REACT_APP_IS_TEST="false"
REACT_APP_PIPLINE="development"

# Feature Flags
REACT_APP_ENABLE_APPLE_LOGIN="false"
REACT_APP_ENABLE_EMAIL_VERIFICATION="false"
REACT_APP_ENABLE_FACEBOOK_LOGIN="false"
REACT_APP_ENABLE_GOOGLE_LOGIN="true"
REACT_APP_ENABLE_SIGNUP="false"
REACT_APP_ENABLE_USERS_REGISTRATION="false"

# Security
REACT_APP_ENCRYPTION_KEY="your-secure-encryption-key-here"

# Social Login Configuration
REACT_APP_APPLE_SIGN_IN_WEB_CLIENT_ID=""
REACT_APP_FACEBOOK_SIGN_IN_WEB_CLIENT_ID=""
REACT_APP_GOOGLE_SIGN_IN_WEB_CLIENT_ID="your-google-web-client-id"

# Firebase Configuration
REACT_APP_FIREBASE_VAPID_KEY="your-firebase-vapid-key"
REACT_APP_FIREBASE_WEB_API_KEY="your-firebase-api-key"
REACT_APP_FIREBASE_WEB_APP_ID="your-firebase-app-id"
REACT_APP_FIREBASE_WEB_AUTH_DOMAIN="your-project.firebaseapp.com"
REACT_APP_FIREBASE_WEB_MESSAGING_SENDER_ID="your-firebase-messaging-sender-id"
REACT_APP_FIREBASE_WEB_MEASUREMENT_ID="your-firebase-measurement-id"
REACT_APP_FIREBASE_WEB_PROJECT_ID="your-firebase-project-id"
REACT_APP_FIREBASE_WEB_STORAGE_BUCKET="your-project.appspot.com"

# Company Contact Information
REACT_APP_COMPANY_ADDRESS=""
REACT_APP_SUPPORT_EMAIL="support@leaguer.com"

# Social Media Links (Optional - leave empty to hide from footer)
REACT_APP_SOCIAL_FACEBOOK_URL="https://facebook.com/leaguer"
REACT_APP_SOCIAL_TWITTER_URL="https://twitter.com/leaguer"
REACT_APP_SOCIAL_INSTAGRAM_URL="https://instagram.com/leaguer"
REACT_APP_SOCIAL_TIKTOK_URL="https://tiktok.com/@leaguer"
REACT_APP_SOCIAL_YOUTUBE_URL="https://youtube.com/@leaguer"
REACT_APP_SOCIAL_LINKEDIN_URL=""

# WebSocket Configuration
REACT_APP_USE_WEBSOCKETS="true"
REACT_APP_WS_BACKEND_HOST="localhost"
REACT_APP_WS_BACKEND_PORT='port-websocket-backend'

# Build Configuration (Optional)
GENERATE_SOURCEMAP=true
ESLINT_NO_DEV_ERRORS=true
