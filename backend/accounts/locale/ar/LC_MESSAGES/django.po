#: templates/password_reset.html:4 utils.py:177 utils.py:182
msgid "Password Reset Request"
msgstr "طلب إعادة تعيين كلمة المرور"

#: templates/password_reset.html:7
#, python-format
msgid "Hello, %(first_name)s!"
msgstr "مرحبًا، %(first_name)s!"

#: templates/password_reset.html:8
msgid ""
"You have requested to reset your password. Please click the link below to "
"reset your password:"
msgstr ""
"لقد طلبت إعادة تعيين كلمة المرور الخاصة بك. يرجى النقر على الرابط أدناه "
"لإعادة تعيينها:"

#: templates/password_reset.html:10
msgid "Reset Password"
msgstr "إعادة تعيين كلمة المرور"

#: templates/password_reset.html:12
msgid "This link will expire in 24 hours."
msgstr "سينتهي صلاحية هذا الرابط خلال 24 ساعة."

#: templates/password_reset.html:13
msgid ""
"If you did not request this password reset, you can safely ignore this email."
msgstr ""
"إذا لم تطلب إعادة تعيين كلمة المرور هذه، يمكنك تجاهل هذا البريد الإلكتروني "
"بأمان."

#: templates/password_reset.txt:6
msgid ""
"\n"
"You have requested to reset your password. Please click the link below to "
"reset your password:\n"
msgstr ""
"\n"
"لقد طلبت إعادة تعيين كلمة المرور الخاصة بك. يرجى النقر على الرابط أدناه "
"لإعادة تعيينها:\n"

#: templates/password_reset.txt:12
msgid ""
"\n"
"This link will expire in 24 hours.\n"
msgstr ""
"\n"
"سينتهي صلاحية هذا الرابط خلال 24 ساعة.\n"

#: templates/password_reset.txt:16
msgid ""
"\n"
"If you did not request this password reset, you can safely ignore this "
"email.\n"
msgstr ""
"\n"
"إذا لم تطلب إعادة تعيين كلمة المرور هذه، يمكنك تجاهل هذا البريد الإلكتروني "
"بأمان.\n"

#: templates/sms_verification.txt:2
#, python-format
msgid ""
"Your verification code is %(verification_code)s. Please use it to confirm "
"your number. Thank you."
msgstr ""
"رمز التحقق الخاص بك هو %(verification_code)s. يرجى استخدامه لتأكيد رقمك. "
"شكرًا لك."

