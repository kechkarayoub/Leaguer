#: services.py:312
msgid "Verify your email address"
msgstr "Vérifiez votre adresse e-mail"

#: templates/email_verification.html:4
msgid "Verify Your Email"
msgstr "Vérifiez votre e-mail"

#: templates/email_verification.html:7
#, python-format
msgid "Welcome, %(first_name)s!"
msgstr "Bienvenue, %(first_name)s !"

#: templates/email_verification.html:8
msgid ""
"Thank you for registering. Please verify your email by clicking the link "
"below:"
msgstr ""
"Merci de vous être inscrit. Veuillez vérifier votre e-mail en cliquant sur "
"le lien ci-dessous :"

#: templates/email_verification.html:10
msgid "Verify Email"
msgstr "Vérifier l'e-mail"

#: templates/email_verification.html:12
msgid ""
"If you did not sign up for this account, you can safely ignore this email."
msgstr "Si vous n'avez pas créé ce compte, vous pouvez ignorer cet e-mail."

#: templates/email_verification.txt:2 templates/password_reset.txt:2
#, python-format
msgid ""
"\n"
"Hello %(first_name)s,\n"
msgstr ""
"\n"
"Bonjour %(first_name)s,\n"

#: templates/email_verification.txt:6
msgid ""
"\n"
"Thank you for registering. Please verify your email by clicking the link "
"below:\n"
msgstr ""
"\n"
"Merci de vous être inscrit. Veuillez vérifier votre e-mail en cliquant sur "
"le lien ci-dessous :\n"

#: templates/password_reset.html:4 utils.py:177 utils.py:182
msgid "Password Reset Request"
msgstr "Demande de réinitialisation du mot de passe"

#: templates/password_reset.html:7
#, python-format
msgid "Hello, %(first_name)s!"
msgstr "Bonjour, %(first_name)s !"

#: templates/password_reset.html:8
msgid ""
"You have requested to reset your password. Please click the link below to "
"reset your password:"
msgstr ""
"Vous avez demandé à réinitialiser votre mot de passe. Veuillez cliquer sur "
"le lien ci-dessous pour réinitialiser votre mot de passe :"

#: templates/password_reset.html:10
msgid "Reset Password"
msgstr "Réinitialiser le mot de passe"

#: templates/password_reset.html:12
msgid "This link will expire in 24 hours."
msgstr "Ce lien expirera dans 24 heures."

#: templates/password_reset.html:13
msgid ""
"If you did not request this password reset, you can safely ignore this email."
msgstr ""
"Si vous n'avez pas demandé cette réinitialisation de mot de passe, vous "
"pouvez ignorer cet e-mail."

#: templates/password_reset.txt:6
msgid ""
"\n"
"You have requested to reset your password. Please click the link below to "
"reset your password:\n"
msgstr ""
"\n"
"Vous avez demandé à réinitialiser votre mot de passe. Veuillez cliquer sur "
"le lien ci-dessous pour réinitialiser votre mot de passe :\n"

#: templates/password_reset.txt:12
msgid ""
"\n"
"This link will expire in 24 hours.\n"
msgstr ""
"\n"
"Ce lien expirera dans 24 heures.\n"

#: templates/password_reset.txt:16
msgid ""
"\n"
"If you did not request this password reset, you can safely ignore this "
"email.\n"
msgstr ""
"\n"
"Si vous n'avez pas demandé cette réinitialisation de mot de passe, vous "
"pouvez ignorer cet e-mail.\n"

#: templates/sms_verification.txt:2
#, python-format
msgid ""
"Your verification code is %(verification_code)s. Please use it to confirm "
"your number. Thank you."
msgstr ""
"Votre code de vérification est %(verification_code)s. Veuillez l'utiliser "
"pour confirmer votre numéro. Merci."

#: utils.py:18
msgid "Select"
msgstr "Sélectionner"

#: utils.py:18
msgid "Female"
msgstr "Féminin"

#: utils.py:18
msgid "Male"
msgstr "Masculin"

#: utils.py:67 utils.py:72
msgid "Verify Your Email Address"
msgstr "Vérifiez votre adresse e-mail"

#: views.py:64
msgid "User id is required"
msgstr "L'identifiant utilisateur est requis"

#: views.py:74
msgid "Your email is already verified. Try to sign in."
msgstr "Votre e-mail est déjà vérifié. Essayez de vous connecter."

#: views.py:82
msgid ""
"Email not sent. Please contact the technical team to resolve your issue."
msgstr ""
"E-mail non envoyé. Veuillez contacter l'équipe technique pour résoudre votre "
"problème."

#: views.py:84
msgid ""
"A new verification link has been sent to your email address. Please verify "
"your email before logging in."
msgstr ""
"Un nouveau lien de vérification a été envoyé à votre adresse e-mail. "
"Veuillez vérifier votre e-mail avant de vous connecter."

#: views.py:118
msgid "Email/Username and password are required"
msgstr "L'e-mail/le nom d'utilisateur et le mot de passe sont requis"

#: views.py:131 views.py:248
msgid ""
"Your account is deleted. Please contact the technical team to resolve your "
"issue."
msgstr ""
"Votre compte est supprimé. Veuillez contacter l'équipe technique pour "
"résoudre votre problème."

#: views.py:139 views.py:256
msgid ""
"Your account is inactive. Please contact the technical team to resolve your "
"issue."
msgstr ""
"Votre compte est inactif. Veuillez contacter l'équipe technique pour "
"résoudre votre problème."

#: views.py:147
msgid ""
"Your email is not yet verified. Please verify your email address before sign "
"in."
msgstr ""
"Votre e-mail n'est pas encore vérifié. Veuillez vérifier votre adresse e-"
"mail avant de vous connecter."

#: views.py:167 views.py:169 views.py:277
msgid "Invalid credentials"
msgstr "Identifiants invalides"

#: views.py:204 views.py:518
msgid "Email, Id token and Third party type are required"
msgstr "L'e-mail, le jeton d'identité et le type de tiers sont requis"

#: views.py:307
msgid "Email or username is required"
msgstr "L'e-mail ou le nom d'utilisateur est requis"

#: views.py:312
msgid ""
"If an account with this email or username exists, you will receive a "
"password reset link shortly."
msgstr ""
"Si un compte avec cet e-mail ou nom d'utilisateur existe, vous recevrez "
"bientôt un lien de réinitialisation du mot de passe."

#: views.py:374
msgid "All fields are required"
msgstr "Tous les champs sont requis"

#: views.py:383
msgid "Invalid or expired reset token. Please request a new password reset."
msgstr ""
"Jeton de réinitialisation invalide ou expiré. Veuillez demander une nouvelle "
"réinitialisation du mot de passe."

#: views.py:414
msgid ""
"Password has been reset successfully. You can now log in with your new "
"password."
msgstr ""
"Le mot de passe a été réinitialisé avec succès. Vous pouvez maintenant vous "
"connecter avec votre nouveau mot de passe."

#: views.py:421
msgid "An error occurred while resetting your password. Please try again."
msgstr ""
"Une erreur s'est produite lors de la réinitialisation de votre mot de passe. "
"Veuillez réessayer."

#: views.py:470
msgid ""
"Your account is created successfully. Log in with your username and password."
msgstr ""
"Votre compte a été créé avec succès. Connectez-vous avec votre nom "
"d'utilisateur et votre mot de passe."

#: views.py:474
msgid ""
"Your account has been successfully created. You can log in once you validate "
"your email via the link sent to your email address."
msgstr ""
"Votre compte a été créé avec succès. Vous pouvez vous connecter une fois que "
"vous aurez validé votre e-mail via le lien envoyé à votre adresse e-mail."

#: views.py:483
msgid ""
"We cannot create your account due to the following errors. Please correct "
"them and try again."
msgstr ""
"Nous ne pouvons pas créer votre compte en raison des erreurs suivantes. "
"Veuillez les corriger et réessayer."

#: views.py:550
msgid ""
"Unable to verify your account with the provided third-party credentials. "
"Please check your information or try a different sign-up method."
msgstr ""
"Impossible de vérifier votre compte avec les informations d'identification "
"du tiers fournies. Veuillez vérifier vos informations ou essayer une autre "
"méthode d'inscription."

#: views.py:587
msgid ""
"Unable to create or authenticate your account with the provided third-party "
"credentials. Please check your information or try a different sign-up method."
msgstr ""
"Impossible de créer ou d'authentifier votre compte avec les informations "
"d'identification du tiers fournies. Veuillez vérifier vos informations ou "
"essayer une autre méthode d'inscription."

#: views.py:648
msgid ""
"Your profile could not be updated due to the errors listed above. Please "
"correct them and try again."
msgstr ""
"Votre profil n'a pas pu être mis à jour en raison des erreurs listées ci-"
"dessus. Veuillez les corriger et réessayer."

#: views.py:679
msgid "Image upload failed."
msgstr "Échec du téléchargement de l'image."

#: views.py:716
msgid "Your profile has been updated successfully."
msgstr "Votre profil a été mis à jour avec succès."

#: views.py:758
msgid "Votre mot de passe a été mis à jour avec succès."
msgstr "Votre profil a été mis à jour avec succès."

#: views.py:760
msgid ""
"Your password update failed. Please check your current password and try "
"again."
msgstr "La mise à jour de votre mot de passe a échoué. Veuillez vérifier votre mot de passe actuel et réessayer."

#: views.py:777
msgid "Action not exists."
msgstr "L'action n'existe pas."

#: views.py:794 views.py:941
msgid "Missing required parameters."
msgstr "Paramètres requis manquants."

#: views.py:804
msgid "You should add a phone number before validate it!"
msgstr "Vous devez ajouter un numéro de téléphone avant de le valider !"

#: views.py:810
#, python-brace-format
msgid ""
"This phone number already verified for another user. Please contact the "
"technical service at {technical_service_email} to resolve your problem."
msgstr ""
"Ce numéro de téléphone est déjà vérifié pour un autre utilisateur. Veuillez "
"contacter le service technique à {technical_service_email} pour résoudre "
"votre problème."

#: views.py:817
msgid "Invalid verification code."
msgstr "Code de vérification invalide."

#: views.py:820
msgid "Phone number already verified."
msgstr "Numéro de téléphone déjà vérifié."

#: views.py:822
msgid "Phone number verified successfully."
msgstr "Numéro de téléphone vérifié avec succès."

#: views.py:827
msgid "A new verification code will be sent to your phone number."
msgstr ""
"Un nouveau code de vérification sera envoyé à votre numéro de téléphone."

#: views.py:830
msgid "Expired verification code."
msgstr "Code de vérification expiré."

#: views.py:834
#, python-brace-format
msgid ""
"Your sms verification code quota has been exceeded. Please contact the "
"technical service at {technical_service_email} to resolve your problem."
msgstr ""
"Votre quota de codes de vérification SMS a été dépassé. Veuillez contacter "
"le service technique à {technical_service_email} pour résoudre votre "
"problème."

#: views.py:837
msgid "Invalid code."
msgstr "Code invalide."

#: views.py:954
msgid "Invalid verification link."
msgstr "Lien de vérification invalide."

#: views.py:958
msgid "Email already verified."
msgstr "E-mail déjà vérifié."

#: views.py:960
msgid "Email verified successfully."
msgstr "E-mail vérifié avec succès."

#: views.py:964
msgid ""
"Expired token. A new verification email will be sent to your email address."
msgstr ""
"Jeton expiré. Un nouvel e-mail de vérification sera envoyé à votre adresse e-"
"mail."

#: views.py:967
msgid "Invalid token."
msgstr "Jeton invalide."

#: views.py:1001
msgid "Refresh token is required"
msgstr "Le jeton de rafraîchissement est requis."

#: views.py:1034
msgid "Invalid refresh token"
msgstr "Jeton de rafraîchissement invalide."

#: views.py:1064
msgid "Successfully logged out"
msgstr "Déconnexion réussie."

#: views.py:1071
msgid "An error occurred during logout"
msgstr "Une erreur est survenue lors de la déconnexion."

#: views.py:1111
msgid "Invalid language selection"
msgstr "Sélection de langue invalide."

#: views.py:1126
msgid "Invalid timezone selection"
msgstr "Sélection de fuseau horaire invalide."

#: views.py:1140
msgid "Invalid theme selection"
msgstr "Sélection de thème invalide."

#: views.py:1146
msgid "No changes detected"
msgstr "Aucun changement détecté."

#: views.py:1163
msgid "Settings updated successfully"
msgstr "Paramètres mis à jour avec succès."

#: views.py:1171
msgid "An error occurred while updating settings"
msgstr ""
"Une erreur est survenue lors de la mise à jour des paramètres."
